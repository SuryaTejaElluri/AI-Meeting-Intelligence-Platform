# ==========================================
# 🚀 AI Meeting Intelligence Platform .gitignore
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Next.js Build Outputs
.next/
/out/
/build/
/dist/
/.vercel

# Environment & API Secrets (DO NOT COMMIT SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# User Uploaded Media Files (Keep folder structure via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# Python & Whisper Server
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
whisper-server/__pycache__/
whisper-server/*.pt
whisper-server/*.bin
whisper-server/*.exe

# Debug & Execution Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Files & Scratch Data
test-*.js
scratch/
.tmp/
temp/

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
